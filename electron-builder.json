{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.khyberdeliciousfood.pos",
  "productName": "Khyber Delicious Food POS",
  "copyright": "Khyber Delicious Food",
  "directories": {
    "output": "desktop-release",
    "buildResources": "electron"
  },
  "files": ["electron/**/*", "package.json"],
  "extraResources": [
    {
      "from": ".output/server",
      "to": "server"
    },
    {
      "from": ".output/public",
      "to": "server/public"
    }
  ],
  "asar": true,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "electron/icon.ico",
    "artifactName": "Khyber Delicious Food POS Setup ${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Khyber Delicious Food POS",
    "deleteAppDataOnUninstall": false,
    "menuCategory": false
  },
  "publish": null
}
